<style>
  .panel-root {
    flex-direction: column;
    width: 430px;
  }
  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }
  .eyebrow {
    color: #8e7aff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }
  .eyebrow:dark { color: #b7aaff; }
  .heading {
    color: #1c1d20;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
  }
  .heading:dark { color: #fafaf7; }
  .body {
    color: #3a3b40;
    font-size: 19px;
    line-height: 26px;
  }
  .body:dark { color: #dddfe3; }
  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
  }
  .button-label { transform-translate-y: 1px; }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">MELOSPACE · IMMERSIVE MUSIC</div>
    <div class="heading">Your music studio awaits.</div>
    <div class="body">A seated, hands-first space to learn and play.</div>
    <div class="body">Start with the piano. Build your sound.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonLabel class="button-label">Enter the studio</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonLabel class="button-label">Exit to browser</ButtonLabel>
  </Button>
</Panel>
